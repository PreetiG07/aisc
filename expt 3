from heapq import heappush, heappop

CAP_A = 4
CAP_B = 3
GOAL = 2

def heuristic(state):
    return abs(GOAL - state[0])

def successors(state):
    a, b = state
    states = []

    states.append((CAP_A, b))                 # Fill A
    states.append((a, CAP_B))                 # Fill B
    states.append((0, b))                     # Empty A
    states.append((a, 0))                     # Empty B

    transfer = min(a, CAP_B - b)
    states.append((a-transfer, b+transfer))   # A -> B

    transfer = min(b, CAP_A - a)
    states.append((a+transfer, b-transfer))   # B -> A

    return list(set(states))
def successors(state):
    a, b = state
    states = []

    states.append((CAP_A, b))                 # Fill A
    states.append((a, CAP_B))                 # Fill B
    states.append((0, b))                     # Empty A
    states.append((a, 0))                     # Empty B

    transfer = min(a, CAP_B - b)
    states.append((a-transfer, b+transfer))   # A -> B

    transfer = min(b, CAP_A - a)
    states.append((a+transfer, b-transfer))   # B -> A

    return list(set(states))

def astar():
    start = (0,0)
    pq = []
    heappush(pq, (heuristic(start), 0, start, [start]))
    visited = set()

    while pq:
        f, g, state, path = heappop(pq)

        if state in visited:
            continue

        visited.add(state)

        if state[0] == GOAL:
            return path

        for nxt in successors(state):
            if nxt not in visited:
                heappush(pq, (g + 1 + heuristic(nxt), g + 1, nxt, path + [nxt]))

solution = astar()
print("Solution Path:")
for step in solution:
    print(step)
